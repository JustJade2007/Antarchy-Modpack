{
  "DO_NOT_CHANGE_IT": 2,
  "modpackName": "Antarchy",
  "modpackHost": true,
  "generateModpackOnStart": true,
  "syncedFiles": [
    "!/kubejs/server_scripts/**",
    "/mods/*.jar",
    "/kubejs/**",
    "!/mods/voicechat-discord-neoforge-3.2.0-fixed.jar",
    "/emotes/*"
  ],
  "allowEditsInFiles": [
    "/local/**",
    "/xaero/**",
    "/servers*.dat*",
    "/shaderpacks/**",
    "/screenshots/**",
    "/jarmods/**",
    "/logs/**",
    "/config/**",
    "/disabledmods/**",
    "/crash-reports/**",
    "/moddata/**",
    "/saves/**",
    "/schematics/**",
    "/debug/**",
    "/blueprints/**",
    "/downloads/**",
    "/defaultconfigs/**",
    "/imgui.ini",
    "/options.txt",
    "/resourcepacks/**",
    "/command_history.txt",
    "/.mixin.out/**",
    "/mods/**",
    "/XaeroWaypoints_BACKUP*/**",
    "/essential/**",
    "/mimicked/**"
  ],
  "forceCopyFilesToStandardLocation": [],
  "nonModpackFilesToDelete": {},
  "autoExcludeServerSideMods": true,
  "autoExcludeUnnecessaryFiles": true,
  "requireAutoModpackOnClient": true,
  "nagUnModdedClients": true,
  "nagMessage": "Now with auto update!",
  "nagClickableMessage": "Modpack Website!",
  "nagClickableLink": "https://justjade.cc/antarchy",
  "bindAddress": "",
  "bindPort": -1,
  "addressToSend": "",
  "portToSend": -1,
  "disableInternalTLS": false,
  "requireMagicPackets": false,
  "updateIpsOnEveryStart": false,
  "bandwidthLimit": 0,
  "validateSecrets": true,
  "secretLifetime": 336,
  "selfUpdater": true,
  "acceptedLoaders": [
    "neoforge"
  ]
}